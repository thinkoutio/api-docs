                },
                "expanded": false,
                "pages": [
                  "GET /labels",
                  "GET /labels/{id}"
                ]
              },
              {
                "group": "Rapoarte",
                "openapi": {
                  "source": "openapi/v1.ro.yaml",
                  "directory": "ro/api-reference"
